# --- Supabase (Project Settings > API) ---
# URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" — sécurité assurée par les policies RLS, jamais la clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — usage strictement serveur (migrations, Edge Functions, jobs pg_cron).
# Ne jamais exposer côté client, ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (envoi d'e-mails : alertes, digest hebdomadaire, accusés de
# réception d'import par e-mail — voir supabase/functions/notifications et
# supabase/functions/inbound-email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Boîte mail entrante (Postmark ou Mailgun) : domaine configuré côté
# plateforme pour router tout e-mail reçu vers l'Edge Function
# supabase/functions/inbound-email — affichage uniquement (l'adresse réelle
# est <jeton par source>@ce-domaine). Optionnel côté Mailgun : la clé de
# signature webhook, pour vérifier l'authenticité des appels (voir
# doc/boite-mail-entrante si présente, ou le commentaire en tête de
# supabase/functions/inbound-email/index.ts).
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=
MAILGUN_SIGNING_KEY=

# --- Application ---
# URL publique du site, utilisée pour les liens dans les e-mails (magic link, rapports).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Envoi d'e-mails en développement ---
# Sans valeur : aucun e-mail ne part, ils sont lisibles sur /dev/emails
# (journal local .emails-dev/). Avec une adresse (et les clés Resend
# ci-dessus) : tous les e-mails partent vers cette seule adresse de test.
# Sans effet en production.
EMAIL_DEV_REDIRECT=

# --- Cloudflare Turnstile (case anti-robot de l'inscription partenaire) ---
# Tableau de bord Cloudflare > Turnstile. Sans clés : vérification ignorée
# (développement). Obligatoires en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
