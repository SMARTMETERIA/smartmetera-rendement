# --- Supabase (Project Settings > API) ---
# URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" — sécurité assurée par les policies RLS, jamais la clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — usage strictement serveur (migrations, Edge Functions, jobs pg_cron).
# Ne jamais exposer côté client, ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (envoi d'e-mails : magic link custom, rapports, alertes) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Application ---
# URL publique du site, utilisée pour les liens dans les e-mails (magic link, rapports).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dev uniquement : connexion automatique locale (voir scripts/create-dev-user.mjs) ---
# Laisser vide en temps normal. Sans effet hors `next dev`. Ne jamais définir en production.
NEXT_PUBLIC_DEV_AUTO_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_AUTO_LOGIN_PASSWORD=
