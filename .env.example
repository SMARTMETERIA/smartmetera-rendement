# --- Supabase (Project Settings > API) ---
# URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" — sécurité assurée par les policies RLS, jamais la clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — usage strictement serveur (migrations, Edge Functions, jobs pg_cron).
# Ne jamais exposer côté client, ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (envoi d'e-mails : alertes, digest hebdomadaire, accusés de
# réception d'import par e-mail — voir supabase/functions/notifications et
# supabase/functions/inbound-email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Boîte mail entrante (Postmark ou Mailgun) : domaine configuré côté
# plateforme pour router tout e-mail reçu vers l'Edge Function
# supabase/functions/inbound-email — affichage uniquement (l'adresse réelle
# est <jeton par source>@ce-domaine). Optionnel côté Mailgun : la clé de
# signature webhook, pour vérifier l'authenticité des appels (voir
# doc/boite-mail-entrante si présente, ou le commentaire en tête de
# supabase/functions/inbound-email/index.ts).
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=
MAILGUN_SIGNING_KEY=

# --- Application ---
# URL publique du site, utilisée pour les liens dans les e-mails (magic link, rapports).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Envoi d'e-mails en développement ---
# Sans valeur : aucun e-mail ne part, ils sont lisibles sur /dev/emails
# (journal local .emails-dev/). Avec une adresse (et les clés Resend
# ci-dessus) : tous les e-mails partent vers cette seule adresse de test.
# Sans effet en production.
EMAIL_DEV_REDIRECT=

# --- Cloudflare Turnstile (case anti-robot de l'inscription partenaire) ---
# Tableau de bord Cloudflare > Turnstile. Sans clés : vérification ignorée
# (développement). Obligatoires en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Gardien de l'eau : envois (fonction Supabase gardien-envois) ---
# Ces variables sont des « secrets » des fonctions Supabase (tableau de bord
# Supabase > Edge Functions > Secrets), pas du site Next.js.
# journal (défaut, obligatoire en développement) : rien ne part, tout est
#   écrit dans le journal des envois (écran « Journal des envois ») ;
# redirection : tous les e-mails partent vers GARDIEN_EMAIL_REDIRECT ;
# reel : production. SMS, appel et WhatsApp restent journalisés tant
#   que les clés du fournisseur (ci-dessous) manquent.
GARDIEN_ENVOIS_MODE=journal
GARDIEN_EMAIL_REDIRECT=
# Adresse de l'application dans les liens des alertes et des rapports.
GARDIEN_URL_APP=http://localhost:3000

# --- Gardien de l'eau : SMS, appel vocal et WhatsApp (fonction gardien-envois) ---
# Secrets de la fonction Supabase gardien-envois, jamais du site Next.js.
# Désactivés tant que ces variables sont vides : les messages sont seulement
# écrits dans le journal des envois. TODO(RAYAN) : fournisseur à confirmer
# (docs/BLOCKERS.md). Fournisseur branché : Twilio (un compte pour les trois).
GARDIEN_TELEPHONE_FOURNISSEUR=
# Console Twilio > Account Info (identifiant « AC… » et jeton secret).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Facultatif : https://api.dublin.ie1.twilio.com pour la région Irlande.
TWILIO_API_BASE=
# SMS : numéro expéditeur (+33…) OU service de messagerie (« MG… »).
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Appel vocal (France) : numéro qui appelle (+33…).
TWILIO_APPEL_FROM=
# WhatsApp (Maroc) : numéro WhatsApp Business et modèle validé par Meta (« HX… »).
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Mode « redirection » : tous les SMS, appels et WhatsApp partent vers ce
# seul numéro de test (format international, +33…).
GARDIEN_TELEPHONE_REDIRECT=

# --- Sentry (erreurs, sans données personnelles) ---
# Sentry > Settings > Projects > Client Keys (DSN). Vide : aucune erreur
# n'est envoyée. Variable serveur uniquement (jamais NEXT_PUBLIC_) : les
# erreurs du navigateur passent par /api/erreurs, qui les masque.
SENTRY_DSN=
# Facultatif : nom de l'environnement (sinon celui de Vercel).
SENTRY_ENVIRONMENT=

# --- Jeu de démonstration (npm run demo:reset, développement uniquement) ---
# Mot de passe commun des comptes demo-…@example.com (sinon tiré au hasard
# et affiché à la fin du script).
DEMO_MOT_DE_PASSE=
# URL Supabase de production : le script refuse de tourner si
# NEXT_PUBLIC_SUPABASE_URL lui est égale.
SUPABASE_URL_PRODUCTION=
